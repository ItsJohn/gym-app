{
  "name": "gym-app",
  "main": "./index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "prepare": "husky",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,md}\"",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint && eslint './src/**/*.{ts,tsx}' --max-warnings=0",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build:android": "eas build -p android --profile production",
    "build:ios": "eas build -p ios --profile production",
    "submit:android": "eas submit -p android --profile production",
    "submit:ios": "eas submit -p ios --profile production",
    "ship:android": "eas build -p android --profile production && eas submit -p android --profile production",
    "ship:ios": "eas build -p ios --profile production && eas submit -p ios --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@google/generative-ai": "^0.24.1",
    "@react-native-picker/picker": "^2.11.4",
    "@shopify/react-native-skia": "2.6.2",
    "@tanstack/react-query": "^5.101.1",
    "expo": "^56",
    "expo-blur": "~56.0.3",
    "expo-constants": "~56.0.18",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.11",
    "expo-linking": "~56.0.14",
    "expo-notifications": "~56.0.18",
    "expo-router": "~56.2.11",
    "expo-splash-screen": "~56.0.10",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-android-widget": "^0.20.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-get-random-values": "^1.11.0",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3",
    "victory-native": "^41.26.0",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.17",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~56.0.4",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.5",
    "ts-jest": "^29.4.11",
    "typescript": "~6.0.3"
  },
  "private": true,
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}
